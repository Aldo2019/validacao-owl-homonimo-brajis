<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/homonimo#"
     xml:base="http://example.org/homonimo"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:homonimo="http://example.org/homonimo#">
    <owl:Ontology rdf:about="http://example.org/homonimo">
        <rdfs:comment xml:lang="pt">Exemplo do caso do homônimo: controle de autoridade em OWL (axiomas 1 a 5 do artigo).</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/homonimo#autorDe -->

    <owl:ObjectProperty rdf:about="http://example.org/homonimo#autorDe">
        <owl:inverseOf rdf:resource="http://example.org/homonimo#temAutor"/>
    </owl:ObjectProperty>
    


    <!-- http://example.org/homonimo#temAutor -->

    <owl:ObjectProperty rdf:about="http://example.org/homonimo#temAutor"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/homonimo#LivroDeAutoriaUnica -->

    <owl:Class rdf:about="http://example.org/homonimo#LivroDeAutoriaUnica">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://example.org/homonimo#temAutor"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://example.org/homonimo#leaoXIV -->

    <owl:NamedIndividual rdf:about="http://example.org/homonimo#leaoXIV">
        <owl:differentFrom rdf:resource="http://example.org/homonimo#robertWPrevost"/>
        <autorDe rdf:resource="http://example.org/homonimo#probabilityTheisticExplanation"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/homonimo#probabilityTheisticExplanation -->

    <owl:NamedIndividual rdf:about="http://example.org/homonimo#probabilityTheisticExplanation">
        <rdf:type rdf:resource="http://example.org/homonimo#LivroDeAutoriaUnica"/>
    </owl:NamedIndividual>
    


    <!-- http://example.org/homonimo#robertWPrevost -->

    <owl:NamedIndividual rdf:about="http://example.org/homonimo#robertWPrevost">
        <autorDe rdf:resource="http://example.org/homonimo#probabilityTheisticExplanation"/>
    </owl:NamedIndividual>
</rdf:RDF>



